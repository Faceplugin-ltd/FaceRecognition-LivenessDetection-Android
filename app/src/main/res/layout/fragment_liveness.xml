<?xml version="1.0" encoding="utf-8"?>
<!-- Liveness on its own: the camera, the boxes and the score. Nothing to press. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.faceplugin.facerecognitionsdk.shell.LivenessOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="@string/tab_liveness"
        android:textColor="@android:color/white"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <ImageButton
        android:id="@+id/switch_camera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/txt_switch_camera"
        android:src="@drawable/ic_cameraswitch"
        app:tint="@android:color/white"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@android:color/white"
        android:visibility="gone"
        android:textAppearance="?attr/textAppearanceBodyMedium" />
</FrameLayout>
