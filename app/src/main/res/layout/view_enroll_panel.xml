<?xml version="1.0" encoding="utf-8"?>
<!-- Enroll with camera: the captured still, the review of what it was checked for, then the
     name, note and Enroll fields. Inflated by FaceCaptureActivity into its review dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

        <!-- The captured still. It lives in the panel rather than behind it, because the review
             is a dialog and the camera preview is no longer visible underneath. The height
             shrinks while the keyboard is up so the fields and buttons stay reachable. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/capture_face_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/capture_face"
                android:layout_width="match_parent"
                android:layout_height="@dimen/capture_face_height"
                android:contentDescription="@string/capture_face_description"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- What the captured still was checked for, and whether it can be enrolled. -->
        <LinearLayout
            android:id="@+id/capture_review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/capture_review_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/capture_verdict"
                    style="@style/FaceIdentity.Pill" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/capture_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                app:trackCornerRadius="2dp" />

            <LinearLayout
                android:id="@+id/capture_checks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/capture_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/enroll_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/name_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/txt_name"
                app:placeholderText="@string/name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/note_optional"
                app:placeholderText="@string/note_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/note_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/enroll_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorError"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Status of the last enroll attempt (AddPersonActivity). -->
            <FrameLayout
                android:id="@+id/enroll_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enroll_retake"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/capture_retake"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enroll_save"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="2"
                    android:text="@string/action_enroll" />
            </LinearLayout>
        </LinearLayout>
</LinearLayout>
