<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".shell.ShellApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaceIdentity">

        <activity
            android:name=".shell.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FaceIdentity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".shell.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".shell.ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".shell.AttributeResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".shell.MatchesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".shell.AddPersonActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FaceIdentity.Camera"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".shell.ImportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>







    </application>
</manifest>
